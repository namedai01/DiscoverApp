# Copy to `.env` (cp .env.example .env). `.env` is bundled into the app as an
# asset, so never put real secrets here — anyone can unzip the APK and read it.

# Base URL of the Memopin API (backend/). No trailing slash needed.
#   Android emulator -> http://10.0.2.2:8080
#   iOS simulator    -> http://localhost:8080
#   physical device  -> http://<your laptop's LAN IP>:8080
#   deployed         -> the Cloud Run URL, https://<service>-<hash>.run.app
# Plain HTTP only works in debug builds. This file ships inside the app:
# never put DATABASE_URL or any other secret here.
API_BASE_URL=http://10.0.2.2:8080

# Map tiles ({z}/{x}/{y} template). OSM public tiles are for dev only —
# switch to a hosted provider (MapTiler, Stadia, ...) before release.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=OpenStreetMap contributors

# Initial camera of the Maps tab (default: Hanoi).
MAP_INITIAL_LAT=21.03
MAP_INITIAL_LNG=105.78
MAP_INITIAL_ZOOM=5
