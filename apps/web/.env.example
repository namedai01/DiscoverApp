# All NEXT_PUBLIC_* values are exposed to the browser. Never put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# fake | firebase. "fake" is rejected by production builds.
NEXT_PUBLIC_AUTH_MODE=fake

# Firebase web app config (setup guide section 4)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Must equal backend STORAGE_BUCKET.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=memopin-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
NEXT_PUBLIC_MAP_INITIAL_LAT=21.03
NEXT_PUBLIC_MAP_INITIAL_LNG=105.78
NEXT_PUBLIC_MAP_INITIAL_ZOOM=5
