# Copy to .env (gitignored). `make dev` loads it. Keep every value quoted: URLs may contain `&`, which breaks `. ./.env`.
APP_ENV="dev"
PORT="8080"
DATABASE_URL="postgres://memopin:memopin@localhost:5433/memopin?sslmode=disable"
FIREBASE_PROJECT_ID="memopin-app"
STORAGE_BUCKET="memopin-app.firebasestorage.app"
DEFAULT_USER_PHOTO_URL=""
CORS_ORIGINS="http://localhost:3000"
# firebase | fake (fake is refused unless APP_ENV=dev)
AUTH_MODE="fake"
